FROM node:18-alpine
WORKDIR /app
COPY package.json package-lock.json ./

# Copier l'ensemble des sources de l'application (index.html, main.js, style.css, images, public...)
COPY . .

RUN npm install \
    && npm install -g serve \
    && npm run build \
    && rm -rf node_modules
EXPOSE 3000
# Vite génère le build dans le dossier "dist"
CMD [ "serve", "-s", "dist" ]
